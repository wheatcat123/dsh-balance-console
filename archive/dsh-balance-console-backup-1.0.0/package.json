{
  "name": "dsh-balance-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Console-style DeepSeek API balance readout below the Harness composer.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
